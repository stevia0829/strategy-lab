{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strategy Lab IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "universe",
    "benchmark",
    "indicators",
    "entry",
    "exit",
    "selection",
    "execution"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "universe": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "benchmark": {
      "type": "string",
      "minLength": 1
    },
    "start": {
      "type": "string",
      "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "end": {
      "type": "string",
      "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "indicators": {
      "type": "object",
      "maxProperties": 40,
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "sma",
              "ema",
              "rsi",
              "macd",
              "roc",
              "momentum_score",
              "atr",
              "highest",
              "lowest"
            ]
          },
          "field": {
            "enum": [
              "open",
              "high",
              "low",
              "close",
              "volume"
            ]
          },
          "period": {
            "type": "integer",
            "minimum": 2,
            "maximum": 500
          },
          "fast": {
            "type": "integer",
            "minimum": 2,
            "maximum": 500
          },
          "slow": {
            "type": "integer",
            "minimum": 2,
            "maximum": 500
          },
          "signal": {
            "type": "integer",
            "minimum": 2,
            "maximum": 500
          },
          "output": {
            "enum": [
              "line",
              "signal",
              "hist"
            ]
          }
        },
        "if": {
          "properties": {
            "kind": {
              "const": "macd"
            }
          }
        },
        "else": {
          "required": [
            "period"
          ]
        }
      }
    },
    "entry": {
      "$ref": "#/$defs/rule"
    },
    "exit": {
      "$ref": "#/$defs/rule"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_positions",
        "rank_by",
        "descending",
        "mode"
      ],
      "properties": {
        "max_positions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "rank_by": {
          "type": "string"
        },
        "descending": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "hold",
            "rotate"
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_cash",
        "commission_rate",
        "min_commission",
        "slippage",
        "lot_size",
        "max_exposure"
      ],
      "properties": {
        "initial_cash": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000000.0
        },
        "commission_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.05
        },
        "min_commission": {
          "type": "number",
          "minimum": 0
        },
        "slippage": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1
        },
        "lot_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_exposure": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "$defs": {
    "rule": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "required": [
            "left",
            "op",
            "right"
          ],
          "additionalProperties": false,
          "properties": {
            "left": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "op": {
              "enum": [
                "gt",
                "gte",
                "lt",
                "lte",
                "eq",
                "cross_above",
                "cross_below"
              ]
            },
            "right": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/rule"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/rule"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/rule"
            }
          }
        }
      ]
    }
  }
}
